# Copia este archivo a .env y llena los valores. Nunca subas el .env al repositorio.
# Los roles se crean con prisma/sql/roles.sql (ver backend/README.md).

# Servidor (Prisma Client), rol echo_app
DATABASE_URL=postgresql://echo_app:CLAVE@localhost:5432/echo
# Migraciones (prisma migrate), rol echo_migracion
DATABASE_URL_MIGRACION=postgresql://echo_migracion:CLAVE@localhost:5432/echo
# Solo desarrollo: base sombra de «prisma migrate dev»
DATABASE_URL_SOMBRA=postgresql://echo_migracion:CLAVE@localhost:5432/echo_sombra
# Scripts de carga de contenido, rol echo_contenido
DATABASE_URL_CONTENIDO=postgresql://echo_contenido:CLAVE@localhost:5432/echo
# Soporte y análisis, rol echo_lectura
DATABASE_URL_LECTURA=postgresql://echo_lectura:CLAVE@localhost:5432/echo

# Origen del frontend: el único Origin aceptado en las mutaciones (DEC-85)
URL_FRONTEND=http://localhost:3000
# Secreto de las claves opacas de la relación de columnas (DEC-91). Genera uno con: openssl rand -hex 32
SECRETO_CLAVE_OPACA=
# Proxies propios que agregan una entrada a X-Forwarded-For (DEC-92): 0 en desarrollo
PROXIES_CONFIABLES=0
# Puerto del servidor
PORT=4000
# Correo con Resend. En desarrollo se dejan vacías las dos y los correos no se envían. Sin dominio verificado,
# el remitente es "Echo <onboarding@resend.dev>" y solo llegan a la dirección de la cuenta de Resend (DEC-66)
RESEND_API_KEY=
CORREO_REMITENTE=
# Inicio con Google (parte 3B): cliente OAuth web de Google Cloud y la URL de regreso registrada en él
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_URL_REGRESO=http://localhost:3000/api/auth/google/callback
