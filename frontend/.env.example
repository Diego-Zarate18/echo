# URL interna del backend. El rewrite de next.config.ts lleva /api/* hacia aquí y servidor.ts la usa por la
# red privada. Es solo de servidor: nunca con el prefijo NEXT_PUBLIC_ (INV-29).
# En desarrollo, la API simulada (npm run simulador) escucha en el puerto 4000.
# En Railway: http://backend.railway.internal:<puerto>
API_URL_INTERNA=http://localhost:4000
